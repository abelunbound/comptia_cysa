# CySA+ Exam App - Environment Variables Template
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to the repository (it's in .gitignore).
# Cloud Run ignores this file and uses Secret Manager instead.

# Required: Flask session secret key
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here

# Required: PostgreSQL. SQLite is not supported.
# The app does not load this file automatically — export the vars in your shell.
#
# Local (Cloud SQL Auth Proxy on 127.0.0.1:5432) — same DB as staging:
# DATABASE_URL=postgresql+psycopg2://cysa_app:PASSWORD@127.0.0.1:5432/cybersecuritylab
#
# Staging Cloud Run (Secret Manager cysa-exam-database-url, Unix socket):
# DATABASE_URL=postgresql+psycopg2://cysa_app:PASSWORD@/cybersecuritylab?host=/cloudsql/bankpassport-be:us-central1:bankpassport
#
# Tests/CI (ephemeral Postgres — never staging):
# TEST_DATABASE_URL=postgresql+psycopg2://cysa_test:cysa_test@127.0.0.1:5432/cysa_test

# Local HTTP only. Do not set this on Cloud Run.
SESSION_COOKIE_SECURE=false
