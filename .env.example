# CySA+ Exam App - Environment Variables Template
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to the repository (it's in .gitignore).

# Required: Flask session secret key
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here

# Optional: Database connection string
# Default: SQLite (instance/users.db) for local development
# Production: Set to Cloud SQL PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host/dbname

# Optional: Session cookie security
# For local HTTP development (http://127.0.0.1:8050), set to false
# IMPORTANT: Do NOT set to false in production (Cloud Run uses HTTPS)
# Default: true for production, false for FLASK_DEBUG=1 or ENV=development
SESSION_COOKIE_SECURE=false
