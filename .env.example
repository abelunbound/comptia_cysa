# CySA+ Exam App - Environment Variables Template
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to the repository (it's in .gitignore).

# Required: Flask session secret key
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here

# Database connection string
# Local/tests (default): omit DATABASE_URL → SQLite at instance/users.db
# M2 Cloud Run: Postgres via Cloud SQL Unix socket (store in Secret Manager):
# DATABASE_URL=postgresql+psycopg2://cysa_app:PASSWORD@/cybersecuritylab?host=/cloudsql/bankpassport-be:us-central1:bankpassport
# Local seed via Cloud SQL Auth Proxy (example):
# DATABASE_URL=postgresql+psycopg2://cysa_app:PASSWORD@127.0.0.1:5432/cybersecuritylab

# Optional: Session cookie security
# For local HTTP only (http://127.0.0.1:8050). Uncomment locally; leave unset on Cloud Run.
# SESSION_COOKIE_SECURE=false
